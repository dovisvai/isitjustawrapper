---
import Base from '../layouts/Base.astro';
import { loadEntries, loadMeterChangelog, loadMeterMeasurements } from '../lib/data.ts';
import { NOT_MEASURED, meterPerDollar, changeDate, lastChangedLabel, money, price, longDate } from '../lib/format.ts';

const entries = [...loadEntries()].sort((a, b) => a.app.name.localeCompare(b.app.name));
const changes = loadMeterChangelog();
const names = new Map(entries.map((e) => [e.app.slug, e.app.name]));
const measured = loadMeterMeasurements();
const fmtMultiple = (n: number) => `${Number.isInteger(n) ? n : n.toFixed(n < 100 ? 2 : 1).replace(/0$/, '')}x`;
---

<Base
  title="The Meter - what an AI seat actually includes | Is it just a wrapper?"
  description="The sticker price of an AI plan rarely changes. The usage it includes, in API dollars, does. API value per seat for every product, and a dated, sourced changelog of every meter change."
  current="meter"
>
  <h1>The Meter</h1>
  <p class="lede">
    The sticker price of an AI plan stays put, but the meter behind it moves. This page tracks what each seat includes
    in API dollars, and logs every time a vendor retunes it.
  </p>

  <div class="table-scroll" style="margin-top:1.5rem">
    <table class="directory meter-table" id="meter-table">
      <caption>
        <span class="directory__note">
          API value per seat is the estimated API spend a month of the plan includes, valued at the vendor's own API
          or stated credit rate. Blank means the vendor publishes no usable rate. Some vendors, such as Cursor and
          Windsurf, stopped publishing one.
        </span>
      </caption>
      <thead>
        <tr>
          <th scope="col" data-sort="name" aria-sort="ascending"><button type="button">Tool</button></th>
          <th scope="col" class="num" data-sort="price">
            <button type="button"
              ><span class="lbl-full">Sticker / mo</span><span class="lbl-short" aria-hidden="true">Price</span></button
            >
          </th>
          <th scope="col" class="num" data-sort="value">
            <button type="button"
              ><span class="lbl-full">API value / seat</span><span class="lbl-short" aria-hidden="true">Value</span
              ></button
            >
          </th>
          <th scope="col" class="num" data-sort="ratio">
            <button type="button"
              ><span class="lbl-full">Value per $1</span><span class="lbl-short" aria-hidden="true">Per $1</span></button
            >
          </th>
          <th scope="col" class="col-hide-sm" data-sort="changed"><button type="button">Last changed</button></th>
        </tr>
      </thead>
      <tbody>
        {
          entries.map(({ app }) => {
            const value = app.meter?.apiValuePerSeat ?? null;
            const ratio = meterPerDollar(value, app.pricing.monthlyUsd);
            const changed = app.meter?.lastChanged ?? null;
            return (
              <tr
                data-name={app.name.toLowerCase()}
                data-price={app.pricing.monthlyUsd}
                data-value={value ?? ''}
                data-ratio={ratio ?? ''}
                data-changed={changed ?? ''}
              >
                <td class="col-name">
                  <a href={`/app/${app.slug}/`}>{app.name}</a>
                  <span class="meta">{app.pricing.tier}</span>
                </td>
                <td class="num">{price(app.pricing.monthlyUsd)}</td>
                <td class:list={['num', { 'is-unmeasured': value === null }]}>
                  {value === null ? NOT_MEASURED : money(value)}
                  {app.meter?.isFloor && <span class="meter-floor">floor</span>}
                </td>
                <td class:list={['num', { 'is-unmeasured': ratio === null }]}>
                  {ratio === null ? NOT_MEASURED : money(ratio)}
                </td>
                <td class:list={['col-hide-sm', { 'is-unmeasured': !changed }]}>
                  {lastChangedLabel(changed, value !== null)}
                </td>
              </tr>
            );
          })
        }
      </tbody>
    </table>
  </div>

  <section style="margin-top:2.5rem" aria-labelledby="measured">
    <h2 id="measured">Independently measured plans</h2>
    <p class="small muted">
      Plans outside the directory, measured by running their allowance down and pricing every call at API list price.
      Highest multiplier first.
    </p>
    <div class="table-scroll" style="margin-top:1rem">
      <table class="directory measured-table">
        <thead>
          <tr>
            <th scope="col"><span class="th-static">Plan</span></th>
            <th scope="col" class="num">
              <span class="th-static"><span class="lbl-full">Price / mo</span><span class="lbl-short" aria-hidden="true">Price</span></span
              >
            </th>
            <th scope="col" class="num">
              <span class="th-static"><span class="lbl-full">API value / mo</span><span class="lbl-short" aria-hidden="true">Value</span
                ></span
              >
            </th>
            <th scope="col" class="num">
              <span class="th-static"><span class="lbl-full">Multiplier</span><span class="lbl-short" aria-hidden="true">x</span></span
              >
            </th>
            <th scope="col" class="col-hide-sm"><span class="th-static">Status</span></th>
            <th scope="col" class="col-hide-sm"><span class="th-static">Measured on</span></th>
          </tr>
        </thead>
        <tbody>
          {
            measured.map((m) => (
              <tr>
                <td class="col-name">
                  <span class="measured-table__plan">{m.plan}</span>
                  <span class="meta">{m.vendor}</span>
                  {/* Phones only: the status column is hidden there, so the tag rides here. */}
                  <span class:list={['tag', 'measured-table__tag-sm', { 'tag--derived': !m.measured }]}>
                    {m.measured ? 'Measured' : 'Derived'}
                  </span>
                  {m.note && <span class="measured-table__note">{m.note}</span>}
                </td>
                <td class="num">{price(m.pricePerMonth)}</td>
                <td class="num">{price(m.apiValuePerMonth)}</td>
                <td class="num measured-table__x">
                  {fmtMultiple(m.multiplier)}
                  {m.multiplierRange && (
                    <span class="measured-table__range">
                      {m.multiplierRange[0]}-{m.multiplierRange[1]}x
                    </span>
                  )}
                </td>
                <td class="col-hide-sm">
                  <span class:list={['tag', { 'tag--derived': !m.measured }]}>{m.measured ? 'Measured' : 'Derived'}</span>
                </td>
                <td class="col-hide-sm">{longDate(m.measuredOn)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="small muted" style="margin-top:.7rem">
      Independent measurement, one run per plan, Oct 1 2026. Vendors can change meters at any time. Source:
      <a href="https://github.com/phuryn/experiments/tree/main/subscription-multipliers" rel="noopener" target="_blank"
        >Pawel Huryn</a
      >.
    </p>
  </section>

  <section class="clause" style="margin-top:2.5rem" aria-labelledby="changelog">
    <h2 id="changelog">Changelog</h2>
    <p class="small muted">
      Every meter change we can source, newest first. Plans not listed in the directory are included when the change is
      on the record. Know of one? Email it with a link, or open an issue.
    </p>
    {
      changes.length === 0 ? (
        <p class="empty-state">No meter changes logged yet.</p>
      ) : (
        <ol class="meter-log">
          {changes.map((c) => (
            <li class="meter-log__item">
              <time datetime={c.date}>{changeDate(c.date, c.approximate)}</time>
              <h3 class="meter-log__tool">
                {c.slug && names.has(c.slug) ? <a href={`/app/${c.slug}/`}>{c.tool}</a> : c.tool}
              </h3>
              <p>{c.summary}</p>
              {(c.before || c.after) && (
                <dl class="meter-log__delta">
                  {c.before && (
                    <div>
                      <dt>Before</dt>
                      <dd>{c.before}</dd>
                    </div>
                  )}
                  {c.after && (
                    <div>
                      <dt>After</dt>
                      <dd>{c.after}</dd>
                    </div>
                  )}
                </dl>
              )}
              <a href={c.source} rel="nofollow noopener" target="_blank">
                Source
              </a>
            </li>
          ))}
        </ol>
      )
    }
    <p class="small muted meter-sponsor">
      Want your plan measured, or your allowance change listed? Sponsors get a placement, never a verdict.
      <a href="/sponsor/">Sponsorship</a>
    </p>
  </section>
</Base>

<script>
  // Same pattern as the directory: rows are server-rendered, sorting reorders them
  // and records the state on the header via aria-sort. Unmeasured values sort last
  // in either direction, so the measured ones stay together at the top.
  const table = document.getElementById('meter-table') as HTMLTableElement | null;
  const body = table?.tBodies[0];
  if (table && body) {
    const rows = Array.from(body.rows);
    let sortKey = 'name';
    let descending = false;

    const sort = (key: string) => {
      if (key === sortKey) descending = !descending;
      else {
        sortKey = key;
        descending = key !== 'name';
      }
      const val = (r: HTMLTableRowElement) => r.dataset[sortKey] ?? '';
      rows.sort((a, b) => {
        const x = val(a);
        const y = val(b);
        if (x === '' || y === '') return x === y ? 0 : x === '' ? 1 : -1;
        const result = sortKey === 'name' || sortKey === 'changed' ? x.localeCompare(y) : Number(x) - Number(y);
        return descending ? -result : result;
      });
      for (const r of rows) body.appendChild(r);
      for (const th of table.tHead!.rows[0]!.cells) {
        if (th.dataset.sort === sortKey) th.setAttribute('aria-sort', descending ? 'descending' : 'ascending');
        else th.removeAttribute('aria-sort');
      }
    };

    for (const th of table.tHead!.rows[0]!.cells) {
      th.querySelector('button')?.addEventListener('click', () => sort(th.dataset.sort!));
    }
  }
</script>
